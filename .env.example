# Used only by deploy/001_deploy_and_smoke.py when overriding the bundled demo fixture.
CANON_DEPLOY_NETWORK=studionet
CANON_DEPLOY_WORLD_ID=EMBER-REALM
CANON_DEPLOY_CANON_VERSION=CANON-V1
CANON_DEPLOY_OUTPUT=deployments/studionet-smoke.json
CANON_SOURCE_COMMIT=FULL_SOURCE_COMMIT_SHA
CANON_RESUME=0
CANON_RESUME_SUBMIT=0

# Required by the JavaScript Bradbury proof harness. The outer EVM chain and
# consensus-critical gl.message.chain_id are separate domains on Bradbury.
CANON_EXPECTED_CHAIN_ID=4221
CANON_EXPECTED_GENVM_CHAIN_ID=1
CANON_EXPECTED_NETWORK_NAME=Genlayer Bradbury Testnet
CANON_DEPLOYMENT_OUTPUT=deployments/bradbury-YYYY-MM-DD.json
